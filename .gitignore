# Sensitive config
wp-config.php
.htaccess
.env

# Uploads (user media)
wp-content/uploads/

# Logs
wp-content/debug.log
*.log

# Cache / backups / upgrade artifacts
wp-content/cache/
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/backup*/
wp-content/backups/

# Zip archives anywhere in the repo (including partial/temp download files)
*.zip
*.zip.*

# Node / build tooling
node_modules/
vendor/
npm-debug.log
yarn-error.log

# Ultimate Multisite ships its compiled PHP dependencies inside the plugin
# zip itself (no composer available in this environment to rebuild them) -
# the blanket vendor/ rule above would otherwise silently drop them.
!wp-content/plugins/ultimate-multisite/vendor/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
